{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "control-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"ENVIRONMENT": "development",
		"FRONTEND_URL": "http://localhost:5173"
	},
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "control-storage",
			"preview_bucket_name": "control-storage",
			"remote": true
		}
	],
	"upload_source_maps": true
}