{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "control-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"ENVIRONMENT": "development",
